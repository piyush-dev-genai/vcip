# V-CIP MVP — local infrastructure credentials (docker compose).
#
#   cp .env.example .env
#   docker compose up -d
#
# infra/.env is gitignored. Never commit real values.
#
# ---------------------------------------------------------------------------
# This file provisions the CONTAINERS. The application processes read the
# repository-root .env. Three groups of values must be identical in both:
#
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB  <->  DATABASE_URL
#   LIVEKIT_API_KEY / LIVEKIT_API_SECRET             <->  LIVEKIT_API_KEY / LIVEKIT_API_SECRET
#   MINIO_ROOT_USER / MINIO_ROOT_PASSWORD            <->  AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#
# The defaults below already match the repository-root .env.example.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ postgres
# Authoritative store for durable business state (D1).
POSTGRES_USER=vcip
POSTGRES_PASSWORD=vcip
POSTGRES_DB=vcip
POSTGRES_PORT=5432

# --------------------------------------------------------------------- redis
# Temporary / real-time state only (D2).
#   db 0 -> application (presence, queue signalling, idempotency)
#   db 1 -> LiveKit <-> Egress control plane
REDIS_PORT=6379

# ------------------------------------------------------------------- livekit
# LIVEKIT_API_KEY is a public identifier, not a credential. It is also written
# into livekit.yaml as webhook.api_key — change both together.
# LIVEKIT_API_SECRET must be at least 32 characters.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-me-with-a-long-random-secret
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
EGRESS_HEALTH_PORT=7981

# --------------------------------------------------------------------- minio
# Local S3-compatible storage. MinIO requires a password of 8+ characters.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Buckets created on first start by the one-shot minio-init service.
#   vcip-temp       raw recordings and working files, purged after export
#   vcip-enterprise signed evidence delivered to the enterprise
S3_BUCKET_TEMP=vcip-temp
S3_BUCKET_ENTERPRISE=vcip-enterprise
S3_REGION=ap-south-1
