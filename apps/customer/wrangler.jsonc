{
  // V-CIP customer application on Cloudflare Workers (docs/07-deployment.md).
  //
  // Deployed as static assets plus one Worker. Every prerendered page is served
  // from the assets binding and never invokes the Worker at all; the Worker
  // runs only for `/api/demo/session`, which holds the D14 enterprise key and
  // must stay on the server.
  //
  // No custom domain. The deployment answers on
  // `vcip-customer.<subdomain>.workers.dev`, which is the HTTPS origin to give
  // the Control API as CUSTOMER_ORIGIN.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vcip-customer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",

  // `nodejs_compat` is what lets the route handler run on the `nodejs` runtime
  // it declares. `global_fetch_strictly_public` makes `fetch` reach the public
  // internet rather than looping back into this Worker, which is how the
  // bootstrap route reaches the Control API on Render.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  "observability": {
    "enabled": true,
  },

  // Configuration, not credentials, and committed rather than left in the
  // dashboard on purpose. `wrangler deploy` treats this file as the source of
  // truth for plain-text variables: deploying with no `vars` block *removes*
  // whatever the dashboard holds, and Workers Builds runs a deploy on every
  // push. A dashboard value therefore survives until the next commit and then
  // silently disappears — which presents as the demo bootstrap being off, with
  // nothing to say why.
  //
  // Neither value is a secret. One is a public hostname; the other is the
  // string "yes". Committing them costs nothing and makes a deployment
  // reproducible from the repository alone.
  "vars": {
    "VCIP_API_BASE_URL": "https://vcip-api.onrender.com",
    "VCIP_DEMO_BOOTSTRAP": "yes",
  },

  // VCIP_DEMO_API_KEY is deliberately absent. It is the D14 enterprise
  // credential, set with `wrangler secret put` and never committed. Secrets are
  // preserved across deploys, so it does not have the problem described above.
  //
  // The two NEXT_PUBLIC_ values are absent for a different reason: Next inlines
  // them into the bundle during `next build`, so they belong to the build
  // (Workers Builds -> Settings -> Build -> Build variables) and not to the
  // runtime. Setting them here would have no effect whatsoever.
}
