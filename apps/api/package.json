{
  "name": "@vcip/api",
  "version": "0.0.0",
  "private": true,
  "description": "V-CIP Control API — NestJS modular monolith",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs nest start --watch",
    "build": "nest build",
    "start": "node ../../scripts/with-env.mjs node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node ../../scripts/with-env.mjs drizzle-kit generate",
    "db:migrate": "node ../../scripts/with-env.mjs drizzle-kit migrate",
    "db:push": "node ../../scripts/with-env.mjs drizzle-kit push",
    "db:seed": "node ../../scripts/with-env.mjs tsx db/seed.ts",
    "db:verify-events": "tsx scripts/verify-events.ts",
    "db:verify-queue": "tsx scripts/verify-queue.ts",
    "db:verify-presence": "tsx scripts/verify-presence.ts",
    "db:verify-agent-queue": "tsx scripts/verify-agent-queue.ts",
    "db:verify-agent-claim": "tsx scripts/verify-agent-claim.ts",
    "db:verify-agent-accept": "tsx scripts/verify-agent-accept.ts",
    "db:verify-media-token": "tsx scripts/verify-media-token.ts",
    "db:verify-day2-gate": "nest build && tsx scripts/verify-day2-gate.ts",
    "db:verify-verdict": "node ../../scripts/with-env.mjs tsx scripts/verify-verdict.ts",
    "db:verify-call-start": "node ../../scripts/with-env.mjs tsx scripts/verify-call-start.ts",
    "db:verify-verdict-race": "node ../../scripts/with-env.mjs tsx scripts/verify-verdict-race.ts",
    "db:verify-abort": "node ../../scripts/with-env.mjs tsx scripts/verify-abort.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-ws": "^11.2.3",
    "@nestjs/websockets": "^11.2.3",
    "@vcip/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "livekit-server-sdk": "^2.18.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.3",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.7.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.0"
  }
}
