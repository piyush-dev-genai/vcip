root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Source-of-truth design documents keep their existing line endings.
[docs/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
