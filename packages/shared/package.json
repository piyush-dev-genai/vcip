{
  "name": "@vcip/shared",
  "version": "0.0.0",
  "private": true,
  "description": "V-CIP shared domain logic — enums, state machine, billing, errors, events, API schemas. Pure; no I/O.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "zod": "^4.5.1"
  }
}
