# V-CIP MVP — environment template
#
# Copy to .env and fill in real values. NEVER commit .env.
# Placeholder values only in this file.
#
# See docs/05-development-plan.md section 9.
#
# The local infrastructure has its own template at infra/.env.example, which
# provisions the containers (T03). These values must be kept identical in both
# files, because one side creates the credential and the other consumes it:
#
#   DATABASE_URL user/password/db  <->  POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#   LIVEKIT_API_KEY / _SECRET      <->  LIVEKIT_API_KEY / LIVEKIT_API_SECRET
#   AWS_ACCESS_KEY_ID / _SECRET_.. <->  MINIO_ROOT_USER / MINIO_ROOT_PASSWORD

# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3001
CUSTOMER_PORT=3000
AGENT_PORT=3002
AI_PORT=8000

# ---------------------------------------------------------------- browser access
# Origins the Control API allows a browser to read responses from (T14). Comma
# separated; each entry must be a bare origin with no path or trailing slash.
#
# Unset means NO origin is allowed, which is deliberate: a missing allow-list
# should stop the browser, not open the API. CORS is an origin policy only —
# every route still requires its own credential.
CUSTOMER_ORIGIN=http://localhost:3000

AGENT_ORIGIN=http://localhost:3002


# The agent portal is a separate origin and needs its own entry (T16). Both
# variables are merged into one allow-list; either may be unset.

# The two NEXT_PUBLIC_ values, read by both browser apps. Both are addresses
# and neither authorises anything: they are inlined into the bundle, so nothing
# secret may ever be added alongside them.
#
# Where the browsers send their API requests.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Where the browsers open their media connection (T25). A browser cannot
# connect to a server whose address it does not know, and knowing the address
# admits nobody to a room — the media token does that, it is minted per session
# and per role by the Control API, and LIVEKIT_API_SECRET stays on the server.
# Mirrors LIVEKIT_URL below; per D24 the value differs by environment and the
# code does not.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ------------------------------------------------------- demo session bootstrap
# D14: the enterprise backend creates sessions with its API key, and for the
# demo a server-side route handler in apps/customer stands in for it. These two
# are read by that route handler only, on the server. VCIP_DEMO_API_KEY must
# never gain a NEXT_PUBLIC_ prefix and must never reach the browser.
#
# Issue a development key with:  pnpm --filter @vcip/api db:seed
VCIP_API_BASE_URL=http://localhost:3001
VCIP_DEMO_API_KEY=paste-the-development-api-key-from-the-seed-output

# ---------------------------------------------------------------- datastores
# PostgreSQL is authoritative for durable business state (D1).
DATABASE_URL=postgresql://vcip:vcip@localhost:5432/vcip

# Redis holds temporary/real-time state only (D2).
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- livekit
# Local dev: self-hosted via docker compose.
# VC demo:   LiveKit Cloud development project.
# Same code, different values (D24).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# Also verifies the D7 webhook: infra/livekit.yaml names this key pair in
# webhook.api_key, so LiveKit signs its deliveries with the same secret. There
# is no separate webhook key.
LIVEKIT_API_SECRET=replace-me-with-a-long-random-secret

# ---------------------------------------------------------------- object storage
# Whether a call is recorded at all (T28). `AI_ENABLED`'s counterpart.
#
# On here, because the local stack runs the whole pipeline. A deployment that
# stops at the Core MVP sets it to false: nothing downstream reads the file
# before T38, and with it off none of the S3_* values below are required — the
# API skips them at boot rather than demanding credentials for a bucket it will
# never write to. See docs/07-deployment.md.
RECORDING_ENABLED=true

# Local dev uses MinIO; production uses S3. Same client, different endpoint.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_TEMP=vcip-temp

# The address the LiveKit *egress container* uploads recordings through (T28).
# Unset in production, where it is the same S3 endpoint the API uses; set for
# local development, because the API reaches MinIO on the host while the egress
# container reaches it on the compose network. D24: the difference is
# environment, not code.
S3_EGRESS_ENDPOINT=http://minio:9000
S3_BUCKET_ENTERPRISE=vcip-enterprise
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ---------------------------------------------------------------- auth
# These are the names apps/api/src/common/auth/auth.config.ts actually reads.
# Each must be at least 32 characters, and the customer and agent secrets must
# differ - the API refuses to start otherwise, which is deliberate: one shared
# secret would leave a forged `act` claim as the only thing separating a
# customer token from an agent route.
#
# Agent JWT: tenant- and role-scoped, 12 hours, no refresh and no revocation.
VCIP_AGENT_JWT_SECRET=replace-me-with-a-long-random-secret-32-chars-min

# Customer session token: short-lived, session-scoped, stateless (R8).
VCIP_CUSTOMER_TOKEN_SECRET=replace-me-with-a-different-long-random-secret

# Shared credential for /internal/* endpoints. Not publicly routed (D10).
# Signs WebSocket connection tokens (D9, T27). A third distinct secret: a
# connection token travels in a query parameter, so a leak must not be worth as
# much as a session credential. Must differ from the two above.
VCIP_WS_TOKEN_SECRET=replace-me-with-a-long-random-secret

VCIP_INTERNAL_TOKEN=replace-me-with-a-long-random-secret-32-chars-min

# WebSocket connection token: short-lived, scoped to tenant + session/user (D9).
WS_TOKEN_TTL=60s

# ------------------------------------------------- demo agent credentials
# T16: the seed hashes this and stores it as every demo agent's password, so
# it survives a re-seed. Leave it unset and the seed generates one, prints it
# once, and never stores the plaintext.
#
# Development only. Only the scrypt hash reaches PostgreSQL.
#
#   pnpm --filter @vcip/api db:seed
VCIP_DEMO_AGENT_PASSWORD=TestPassword123!

# ---------------------------------------------------------------- signing
# Ed25519 via SigningKeyProvider. AWS KMS does NOT offer Ed25519 signing
# keys, so the MVP injects the key through the environment and keeps the
# provider replaceable for a future HSM/KMS (D12).
SIGNING_KEY_REFERENCE=env:SIGNING_KEY_ED25519_PRIVATE
SIGNING_KEY_ED25519_PRIVATE=replace-me-with-a-base64-ed25519-private-key
SIGNING_KEY_ID=vcip-mvp-ed25519-1

# ---------------------------------------------------------------- webhooks
# HMAC over the raw request body; the enterprise verifies with this secret.
WEBHOOK_HMAC_SECRET=replace-me-with-a-long-random-secret
WEBHOOK_MAX_ATTEMPTS=6

# ---------------------------------------------------------------- workers
# Export retries stay inside export_status=EXPORTING; exhaustion -> FAILED (D22).
EXPORT_MAX_ATTEMPTS=5
OFFER_SWEEPER_INTERVAL_MS=5000
WEBHOOK_WORKER_INTERVAL_MS=5000

# ---------------------------------------------------------------- ai
# AI is assistive and off the video critical path (D6).
AI_INTERNAL_URL=http://localhost:8000
AI_ENABLED=true

# Which provider implementations the AI service builds at startup (T29).
#   mock         deterministic stand-ins, seeded from the session id
#   unavailable  every check reports UNAVAILABLE, for exercising the degraded
#                HUD path without stopping the service
# An unrecognised value stops the process at boot rather than falling back.
AI_PROVIDER_MODE=mock

# Where the face-match reference is read from (R6). Unset uses the demo
# reference shipped in apps/ai/app/reference_data.
# AI_REFERENCE_DIR=

# Where the AI service posts results back (T30). The Control API's internal
# address, from inside the AI service. Unset uses http://localhost:3001.
# AI_CONTROL_API_URL=http://localhost:3001

# Analyzer cadence (T30), in milliseconds. The T05 spike measured I420 -> RGB24
# at 720p costing ~23 ms, so sampling is what keeps one call inside one core:
# frames not sampled are never decoded at all.
#   AI_SAMPLE_INTERVAL_MS  how often a frame is decoded and kept   (4 fps)
#   AI_CHECK_INTERVAL_MS   how often liveness and face match run, and a result
#                          is published to /internal/ai/result
#   AI_OCR_INTERVAL_MS     how often OCR runs — slower, because §19 says a
#                          document read is triggered, not continuous
AI_SAMPLE_INTERVAL_MS=250
AI_CHECK_INTERVAL_MS=2000
AI_OCR_INTERVAL_MS=5000

# Which simulcast layer the analyzer subscribes to: low, medium, high, or unset.
#
# Unset asks for nothing and LiveKit sends the highest, which is what this
# service has always done and what the T05 spike measured at ~75% of a core.
# A host with a fraction of a core sets `low` and pays a fraction of that.
#
# It changes no answer. The providers are seeded from the session id, so in
# `mock` mode a frame's pixels reach no decision at all.
# AI_VIDEO_QUALITY=low

# How long the analyzer waits for the customer's video track before reporting
# one UNAVAILABLE result, and the ceiling on a single analysis.
AI_TRACK_TIMEOUT_S=30
AI_MAX_ANALYSIS_S=7200
